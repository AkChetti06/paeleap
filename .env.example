# Alibaba Model Studio key (region-specific)
DASHSCOPE_API_KEY=
# Use the exact workspace-region URL from Alibaba's Model Studio console.
# e.g. https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=
IMAGE_MODEL=wan2.6-t2i
# Optional OpenAI-compatible text API (may use same Alibaba account if configured)
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL=qwen-plus

# Hugging Face Inference Providers starter credits (not unlimited free usage)
# Get a user token at https://huggingface.co/settings/tokens
HF_TOKEN=
# This model may not be routed by every provider; change to a currently supported text-to-image model when needed.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Cloudflare Workers AI (free tier includes a daily neuron allowance; limits apply)
# Create a Workers AI token and get Account ID at https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
