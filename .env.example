# Server-side only. On Streamlit Community Cloud use Settings > Secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Existing OpenAI-compatible text integration; separate from the image model.
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL=qwen-plus
# Optional path to a local FFmpeg executable if the bundled binary is unavailable.
# IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
